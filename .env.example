# ────────────────────────────────────────────────────────────────────────────
# Environment variables for saas_restaurant local development
# Copy this to .env and fill in your values
# ────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
PLATFORM_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://saas:saaspassword@localhost:5432/saas_restaurant

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: Use a strong random secret in production (minimum 64 chars)
JWT_SECRET=dev-jwt-secret-change-in-production-use-openssl-rand-hex-64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── QR Token ──────────────────────────────────────────────────────────────────
QR_HMAC_SECRET=dev-qr-hmac-secret-change-in-production-use-openssl-rand-hex-64

# ── Storage (MinIO for local dev, AWS S3 for production) ─────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=saas-restaurant
S3_PUBLIC_URL=http://localhost:9000/saas-restaurant

# ── Razorpay (Use test keys - rzp_test_* - for development) ──────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (MailHog for local dev - catches all emails at localhost:8025) ──────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Restaurant Platform
SMTP_FROM_EMAIL=noreply@restaurant.local

# ── Next.js Web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost

# ── Production overrides (uncomment and configure for production) ──────────────
# DATABASE_URL=postgresql://user:pass@your-db-host:5432/saas_restaurant
# REDIS_URL=redis://your-redis-host:6379
# PLATFORM_DOMAIN=yourplatform.com
# NODE_ENV=production
# S3_ENDPOINT=         (leave empty for AWS S3)
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=your-production-bucket
# S3_PUBLIC_URL=https://cdn.yourplatform.com
